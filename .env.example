# App
NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
# Opt-in: abilita il login di sviluppo (mai in produzione)
ENABLE_DEV_ENDPOINTS=false
# Account locali email + password (default: true)
ENABLE_LOCAL_AUTH=true

# Database locale
MONGODB_URI=mongodb://127.0.0.1:27017/health_trainer

# Auth — JWT_SECRET obbligatorio fuori da NODE_ENV=test (min 32 caratteri).
# Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
GOOGLE_CLIENT_ID=
# Opzionale per il flusso GIS ID-token attuale
GOOGLE_CLIENT_SECRET=
# Obbligatoria se GOOGLE_CLIENT_ID è impostata (lista separata da virgole)
GOOGLE_ALLOWED_EMAILS=

# Integrazioni
GARMIN_PERSONAL_API_KEY=
YAZIO_EMAIL=
YAZIO_PASSWORD=
YAZIO_BASE_URL=
YAZIO_CLIENT_ID=
YAZIO_CLIENT_SECRET=
YAZIO_REFRESH_TOKEN=
YAZIO_ACCESS_TOKEN=
YAZIO_TOKEN_EXPIRES_AT=
YAZIO_USER_AGENT=
ZEPP_APP_TOKEN=
ZEPP_USER_ID=
ZEPP_HOST=
HEVY_API_KEY=

# LLM
# Provider cablati: deepseek (nativo). Gli altri restano sul provider deterministico.
LLM_PROVIDER=deepseek
LLM_API_KEY=
# Pianificazione e critica (ragionamento): DeepSeek V4 Pro
LLM_MODEL=deepseek-v4-pro
# Narrazione e task brevi: DeepSeek V4.1 Flash
LLM_MODEL_FAST=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_MS=60000
